{
  "name": "Print Fácil — Captura de tela",
  "short_name": "Print Fácil",
  "description": "Capture a tela em um único toque com um botão flutuante arrastável. Suas imagens ficam apenas no seu dispositivo.",
  "lang": "pt-BR",
  "dir": "ltr",
  "start_url": "./index.html",
  "scope": "./",
  "id": "printfacil",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "any",
  "background_color": "#0a0c12",
  "theme_color": "#0a0c12",
  "categories": ["utilities", "productivity", "photo"],
  "icons": [
    {
      "src": "icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "icons/icon-maskable.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Nova captura",
      "short_name": "Capturar",
      "description": "Iniciar uma captura de tela",
      "url": "./index.html#/home"
    },
    {
      "name": "Minhas capturas",
      "short_name": "Galeria",
      "description": "Abrir a galeria local",
      "url": "./index.html#/gallery"
    }
  ],
  "prefer_related_applications": false
}
